# Copy to $PLACEMENT_RUN_DIR/.env and fill in. Never commit the filled copy.

# MailReach key (starts with mr_live_). Needed to create, poll and score tests.
MAILREACH_API_KEY=

# Optional: if you keep several MailReach accounts, name the variable to bill against.
# MAILREACH_KEY_VAR=MAILREACH_API_KEY_TEAM_A
